[699.472304, "o", "\u001b[24;1H\u001b[?1049l\u001b[23;0;0t\r\u001b[?1l\u001b>\u001b[?1049h\u001b[22;0;0t\u001b[1;33r\u001b[?12l\u001b[?25h\u001b[39;49m\u001b]104\u0007\u001b(B\u001b[m\u001b[4l\u001b[?7h\u001b[H\u001b[2J\u001b[?2004h\u001b[?1h\u001b=\u001b[?1h\u001b=\u001b(B\u001b[0;7m  GNU nano 7.2                                 README.md                                           \u001b[1;98H\u001b(B\u001b[m\r\u001b[3d\u001b(B\u001b[0;1m\u001b[33m## Архитектура проекта\r\u001b[4d\u001b[36m```\r\u001b[5dfinalproject_Nosulchak_dpo_nod/\r\u001b[6d│  \r\u001b[7d├── data/\u001b[27X\u001b[7;37H# Хранилище данных\r\u001b[8d│    ├── users.json\u001b[17X\u001b[8;37H# Пользователи системы\r\u001b[9d│    ├── portfolios.json            # Портфели пользователей  \r\u001b[10d│    └── rates.json\u001b[17X\u001b[10;37H# Кэш текущих курсов валют\r\u001b[11d│\u001b[12d\b├── valutatrade_hub/\u001b[15X\u001b[12;36H# Основной пакет приложения\r\u001b[13d│    ├── __init__.py\r\u001b[14d│    ├── logging_config.py         # Настройка логов (формат, уровень, ротация)\r\u001b[15d│    ├── decorators.py             # @log_action (логирование операций)\r\u001b[16d│    ├── core/\u001b[21X\u001b[16;36H# Ядро приложения - бизнес-логика\r\u001b[17d│    │    ├── __init__.py\r\u001b[18d│    │    ├── currencies.py        # Базовый класс Currency и наследники Fiat/Crypto\r\u001b[19d│    │    ├── exceptions.py        # Пользовательские исключения\r\u001b[20d│    │    ├── models.py            # Модели данных (User, Wallet, Portfolio)\r\u001b[21d│    │    ├── usecases.py          # Бизнес-сценарии с исключениями и логированием\r\u001b[22d│    │    └── utils.py             # Вспомогательные функции (валидация, конвертация)\r\u001b[23d│    ├── infra/\u001b[20X\u001b[23;36H# Инфраструктурный слой\r\u001b[24d│    │    ├─ __init__.py\r\u001b[25d│    │    ├── settings.py          # Singleton SettingsLoader (конфигурация)\r\u001b[26d│    │    └── database.py          # Singleton DatabaseManager (абстракция над JSON)\r\u001b[27d│    ├── parser_service/           # Сервис парсинга курсов валют\r\u001b[28d│    │    ├── __init__.py\r\u001b[29d│    │    ├── config.py            # Конфигурация API и параметров\r\u001b[30d│    │    ├── api_clients.py       # Клиенты внешних API (ExchangeRate-API)\r\u001b[32d\u001b[39m\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Справка\u001b[17G\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Записать     \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Поиск\u001b[32;49H\u001b(B\u001b[0;7m^K\u001b(B\u001b[m Вырезать     \u001b(B\u001b[0;7m^T\u001b(B\u001b[m Выполнить    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Позиция\r\u001b[33d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Выход\u001b[33;17H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m ЧитФайл\u001b[33G\u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Замена\u001b[49G\u001b(B\u001b[0;7m^U\u001b(B\u001b[m Вставить     \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Выровнять    \u001b(B\u001b[0;7m^/\u001b(B\u001b[m К строке\u001b[?25l\u001b[?12l\u001b[?25h\r\u001b[21d\u001b[?25l\u001b[?12l\u001b[?25h"]
