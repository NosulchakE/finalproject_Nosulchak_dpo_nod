[716.097132, "o", "\u001b[2d\u001b(B\u001b[0;1m\u001b[36m│  \r\u001b[3d├── data/\u001b[27X\u001b[3;37H# Хранилище данных\r\u001b[4d│    ├── users.json\u001b[17X\u001b[4;37H# Пользователи системы\r\u001b[5d│    ├── portfolios.json            # Портфели пользователей  \u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[6d\u001b(B\u001b[0;1m\u001b[36m│    └── rates.json\u001b[17X\u001b[6;37H# Кэш текущих курсов валют\r\u001b[7d│\u001b[39m\u001b(B\u001b[m\u001b[K\u001b[8d\b\u001b(B\u001b[0;1m\u001b[36m├── valutatrade_hub/\u001b[15X\u001b[8;36H# Основной пакет приложения\r\u001b[9d│    ├── __init__.py\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[10d\u001b(B\u001b[0;1m\u001b[36m│    ├── logging_config.py         # Настройка логов (формат, уровень, ротация)\r\u001b[11d│    ├── decorators.py             # @log_action (логирование операций)\r\u001b[12d│    ├── core/\u001b[21X\u001b[12;36H# Ядро приложения - бизнес-логика\r\u001b[13d│    │    ├── __init__.py\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[14d\u001b(B\u001b[0;1m\u001b[36m│    │    ├── currencies.py        # Базовый класс Currency и наследники Fiat/Crypto\r\u001b[15d│    │    ├── exceptions.py        # Пользовательские исключения\r\u001b[16d│    │    ├── models.py            # Модели данных (User, Wallet, Portfolio)\r\u001b[17d│    │    ├── usecases.py          # Бизнес-сценарии с исключениями и логированием\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[18d\u001b(B\u001b[0;1m\u001b[36m│    │    └── utils.py             # Вспомогательные функции (валидация, конвертация)\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[19d\u001b(B\u001b[0;1m\u001b[36m│    ├── infra/\u001b[20X\u001b[19;36H# Инфраструктурный слой\r\u001b[20d│    │    ├─ __init__.py\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[21d\u001b(B\u001b[0;1m\u001b[36m│    │    ├── settings.py          # Singleton SettingsLoader (конфигурация)\r\u001b[22d│    │    └── database.py          # Singleton DatabaseManager (абстракция над JSON)\r\u001b[23d│    ├── parser_service/           # Сервис парсинга курсов валют\r\u001b[24d│    │    ├── __init__.py\r\u001b[25d│    │    ├── config.py            # Конфигурация API и параметров\r\u001b[26d│    │    ├── api_clients.py       # Клиенты внешних API (ExchangeRate-API)\u001b[27;4H  │    ├── updater.py           # Логика обновления и кэширования курсов\r\u001b[28d│    │    └── storage.py\u001b[28;36H# Работа с историческими данными\r\u001b[10d\u001b[39m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
