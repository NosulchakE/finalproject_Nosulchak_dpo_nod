[719.509978, "o", "\u001b[?25l\u001b[?12l\u001b[?25h\u001b7\u001b[2;28r\u001b8\u001b[4T\u001b[1;31r\u001b[3;1H🎥 \u001b(B\u001b[0;1m\u001b[32m**Демонстрационное видео:**\u001b[39m\u001b(B\u001b[m \u001b[32m*\u001b(B\u001b[0;1m\u001b[35m[https://asciinema.org/a/iYqOKUoGRmE0f29BHAxwTtT0D]\u001b(B\u001b[0m\u001b[32m*\r\u001b[5d\u001b(B\u001b[0;1m\u001b[33m---\r\u001b[2d\u001b[39m\u001b(B\u001b[m"]
