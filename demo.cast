[635.282378, "o", "\r\u001b[23d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Справка   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Записать  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Поиск     \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Вырезать  \u001b(B\u001b[0;7m^T\u001b(B\u001b[m Выполнить \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Позиция\r\u001b[24d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Выход     \u001b(B\u001b[0;7m^R\u001b(B\u001b[m ЧитФайл   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Замена    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Вставить  \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Выровнять \u001b(B\u001b[0;7m^/\u001b(B\u001b[m К строке\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m# Платформа для отслеживания и симуляции торговли валютами\r\u001b[4d\u001b[39m\u001b(B\u001b[mПроект не является заимствованным, а полностью создан с нуля в соответствии с Т\u001b(B\u001b[0;7m>\u001b[6;1H\u001b(B\u001b[mПроект представляет собой комплексную платформу ValutaTrade Hub, разработанную \u001b(B\u001b[0;7m>\u001b[8;1H\u001b(B\u001b[mРегистрироваться и авторизовываться в системе;\r\u001b[10dУправлять виртуальным портфелем как фиатных, так и криптовалют;\r\u001b[12dСовершать сделки по покупке и продаже валют;\r\u001b[14dОтслеживать актуальные курсы в реальном времени через интеграцию с ExchangeRate\u001b(B\u001b[0;7m>\u001b[16;1H\u001b(B\u001b[mВести историю изменений курсов и портфелей.\r\u001b[18dВ проекте использованы декораторы для логирования и валидации операций, обеспеч\u001b(B\u001b[0;7m>\u001b[20;1H\u001b(B\u001b[mПо требованиям ТЗ проделано следующее:\r\u001b[21d\u001b[35m> CLI-приложение для управления валютным портфелем.\u001b[39m\u001b[44m  \r\u001b[2d\u001b[49m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
